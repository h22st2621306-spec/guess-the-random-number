import { useState, useRef, useCallback } from "react";

function newTarget() {
  return Math.floor(Math.random() * 45) + 1;
}

export default function App() {
  const [target, setTarget] = useState(newTarget);
  const [input, setInput] = useState("");
  const [lastGuess, setLastGuess] = useState(null); // {n, correct}
  const [totalTries, setTotalTries] = useState(0);
  const [wins, setWins] = useState(0);
  const [won, setWon] = useState(false);
  const [shake, setShake] = useState(false);
  const [flash, setFlash] = useState(null); // 'wrong' | 'correct'
  const inputRef = useRef();

  const reset = useCallback((keepStats = true) => {
    setTarget(newTarget());
    setInput("");
    setLastGuess(null);
    setWon(false);
    setFlash(null);
    if (!keepStats) {
      setTotalTries(0);
      setWins(0);
    }
    setTimeout(() => inputRef.current?.focus(), 50);
  }, []);

  const handleGuess = () => {
    const n = parseInt(input);
    if (isNaN(n) || n < 1 || n > 45) {
      setShake(true);
      setTimeout(() => setShake(false), 500);
      return;
    }

    setTotalTries(p => p + 1);
    setInput("");

    if (n === target) {
      setWins(p => p + 1);
      setWon(true);
      setLastGuess({ n, correct: true });
      setFlash("correct");
    } else {
      const diff = n - target;
      let hint = "";
      if (Math.abs(diff) <= 3) hint = diff > 0 ? "🔥 아주 조금 높아요!" : "🔥 아주 조금 낮아요!";
      else if (Math.abs(diff) <= 8) hint = diff > 0 ? "🌡️ 조금 높아요" : "🌡️ 조금 낮아요";
      else hint = diff > 0 ? "❄️ 너무 높아요" : "❄️ 너무 낮아요";

      setLastGuess({ n, hint, correct: false });
      setFlash("wrong");
      // 1번 실패 → 2초 후 자동 리셋
      setTimeout(() => reset(true), 2000);
    }
  };

  return (
    <div style={{
      minHeight: "100vh",
      background: flash === "correct"
        ? "linear-gradient(135deg,#1a3a2e,#0f4d30,#1a5c3a)"
        : flash === "wrong"
        ? "linear-gradient(135deg,#3a1a1a,#4d1515,#5c1a1a)"
        : "linear-gradient(135deg,#1a1a2e,#16213e,#0f3460)",
      transition: "background 0.5s",
      display: "flex", alignItems: "center", justifyContent: "center",
      fontFamily: "'Segoe UI',sans-serif", padding: 16
    }}>
      <div style={{ width: "100%", maxWidth: 420 }}>

        {/* Title */}
        <div style={{ textAlign: "center", marginBottom: 24 }}>
          <div style={{ fontSize: 52 }}>🎯</div>
          <h1 style={{ color: "white", fontSize: 26, fontWeight: 900, margin: "8px 0 4px", letterSpacing: 1 }}>숫자 맞추기</h1>
          <p style={{ color: "rgba(255,255,255,0.5)", fontSize: 14 }}>1 ~ 45 사이의 숫자를 단번에 맞춰보세요!</p>
        </div>

        {/* Stats */}
        <div style={{ display: "flex", gap: 10, justifyContent: "center", marginBottom: 20 }}>
          <div style={{ background: "rgba(255,255,255,0.08)", borderRadius: 99, padding: "6px 18px", color: "rgba(255,255,255,0.7)", fontSize: 14, fontWeight: 600 }}>
            총 시도: <span style={{ color: "#FECA57", fontWeight: 900 }}>{totalTries}</span>
          </div>
          <div style={{ background: "rgba(255,255,255,0.08)", borderRadius: 99, padding: "6px 18px", color: "rgba(255,255,255,0.7)", fontSize: 14, fontWeight: 600 }}>
            성공: <span style={{ color: "#2ecc71", fontWeight: 900 }}>{wins}</span>
          </div>
        </div>

        {/* Card */}
        <div style={{
          background: "rgba(255,255,255,0.07)", backdropFilter: "blur(12px)",
          border: `2px solid ${flash === "correct" ? "#2ecc71" : flash === "wrong" ? "#e74c3c" : "rgba(255,255,255,0.12)"}`,
          transition: "border 0.3s",
          borderRadius: 28, padding: "32px 24px",
          boxShadow: "0 24px 60px rgba(0,0,0,0.4)"
        }}>

          {won ? (
            <div style={{ textAlign: "center" }}>
              <div style={{ fontSize: 64, marginBottom: 8 }}>🏆</div>
              <div style={{ color: "#FECA57", fontSize: 28, fontWeight: 900, marginBottom: 6 }}>정답이에요!</div>
              <div style={{ color: "rgba(255,255,255,0.7)", fontSize: 17, marginBottom: 24 }}>
                정답은 <span style={{ color: "#2ecc71", fontWeight: 800, fontSize: 22 }}>{target}</span> 이었어요 🎊
              </div>
              <button onClick={() => reset(true)} style={{
                background: "linear-gradient(135deg,#FECA57,#FF9F43)", border: "none",
                borderRadius: 16, padding: "13px 36px", fontSize: 16, fontWeight: 800,
                cursor: "pointer", color: "#1a1a2e", boxShadow: "0 4px 20px rgba(254,202,87,0.4)"
              }}>
                다시 도전! 🔄
              </button>
            </div>
          ) : (
            <>
              {/* Last guess result */}
              {lastGuess && !lastGuess.correct && (
                <div style={{
                  background: "rgba(231,76,60,0.2)", border: "1px solid rgba(231,76,60,0.4)",
                  borderRadius: 16, padding: "14px 18px", marginBottom: 20, textAlign: "center",
                  animation: "slideIn 0.3s"
                }}>
                  <div style={{ color: "#FF6B6B", fontWeight: 900, fontSize: 22, marginBottom: 4 }}>
                    ✗ {lastGuess.n} — 틀렸어요!
                  </div>
                  <div style={{ color: "rgba(255,255,255,0.7)", fontSize: 15 }}>{lastGuess.hint}</div>
                  <div style={{ color: "rgba(255,255,255,0.4)", fontSize: 13, marginTop: 6 }}>⏳ 새 숫자로 바뀌는 중...</div>
                </div>
              )}

              {/* Input */}
              <div style={{ display: "flex", gap: 10, animation: shake ? "shake 0.4s" : "none" }}>
                <input
                  ref={inputRef}
                  type="number" min={1} max={45}
                  value={input}
                  onChange={e => setInput(e.target.value)}
                  onKeyDown={e => e.key === "Enter" && handleGuess()}
                  placeholder="1 ~ 45 입력..."
                  disabled={!!lastGuess && !lastGuess.correct}
                  style={{
                    flex: 1, background: "rgba(255,255,255,0.1)",
                    border: "2px solid rgba(255,255,255,0.2)", borderRadius: 14,
                    padding: "13px 18px", fontSize: 18, color: "white",
                    outline: "none", fontFamily: "inherit",
                    opacity: (!!lastGuess && !lastGuess.correct) ? 0.4 : 1
                  }}
                  autoFocus
                />
                <button
                  onClick={handleGuess}
                  disabled={!!lastGuess && !lastGuess.correct}
                  style={{
                    background: "linear-gradient(135deg,#667eea,#764ba2)", color: "white",
                    border: "none", borderRadius: 14, padding: "13px 22px", fontSize: 20,
                    cursor: "pointer", fontWeight: 700,
                    boxShadow: "0 4px 15px rgba(102,126,234,0.5)",
                    opacity: (!!lastGuess && !lastGuess.correct) ? 0.4 : 1
                  }}>
                  ➤
                </button>
              </div>

              <div style={{ textAlign: "center", marginTop: 14, color: "rgba(255,255,255,0.3)", fontSize: 13 }}>
                ⚠️ 한 번이라도 틀리면 새 숫자로 리셋돼요!
              </div>
            </>
          )}
        </div>

        {/* Legend */}
        <div style={{ display: "flex", justifyContent: "center", gap: 16, marginTop: 16, flexWrap: "wrap" }}>
          {[["❄️", "많이 차이나요"], ["🌡️", "조금 차이나요"], ["🔥", "거의 다 왔어요"]].map(([icon, label]) => (
            <div key={label} style={{ color: "rgba(255,255,255,0.4)", fontSize: 12, display: "flex", gap: 4, alignItems: "center" }}>
              <span>{icon}</span><span>{label}</span>
            </div>
          ))}
        </div>
      </div>

      <style>{`
        @keyframes shake { 0%,100%{transform:translateX(0)} 20%,60%{transform:translateX(-8px)} 40%,80%{transform:translateX(8px)} }
        @keyframes slideIn { from{opacity:0;transform:translateY(-10px)} to{opacity:1;transform:none} }
        input[type=number]::-webkit-inner-spin-button { -webkit-appearance:none; }
      `}</style>
    </div>
  );
}
